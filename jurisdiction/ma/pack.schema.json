{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AVENEL Jurisdiction Pack Rule Schema",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.]+$"
    },
    "value": {
      "type": ["number", "string", "boolean", "object", "array", "null"]
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": ["string", "null"],
      "format": "date"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["verified", "needs_expert", "out_of_scope"]
    },
    "note": {
      "type": "string"
    }
  },
  "required": ["key", "value", "effective_from", "source", "status"]
}
